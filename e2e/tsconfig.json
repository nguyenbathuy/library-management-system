{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "typeRoots": ["../server/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
