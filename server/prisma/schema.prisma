generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// --- 1. MẢNG TÀI KHOẢN & HỆ THỐNG ---
model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  password       String
  name           String
  role           String   @default("USER") // "ADMIN" hoặc "USER"
  membershipTier String   @default("STANDARD") // STANDARD, PREMIUM, LECTURER
  isBlacklisted  Boolean  @default(false)      // Chặn mượn sách nếu vi phạm
  
  tokens         Token[]
  loans          Loan[]
  reservations   Reservation[]
  createdAt      DateTime @default(now())
}

model Token {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // VD: "IMPORT_EXCEL", "DELETE_BOOK"
  adminId   Int
  details   String   // Lưu chuỗi JSON chi tiết thay đổi
  createdAt DateTime @default(now())
}

// --- 2. MẢNG QUẢN LÝ SÁCH CHUẨN HÓA ---
model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Author {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Publisher {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Book {
  id            Int      @id @default(autoincrement())
  title         String
  isbn          String   @unique
  categoryId    Int
  authorId      Int
  publisherId   Int?
  publishedYear String?
  pageCount     Int?
  language      String?
  description   String?
  coverImage    String?
  ebookUrl      String? // Đường dẫn file sách điện tử PDF / EPUB

  // Liên kết khóa ngoại
  category      Category   @relation(fields: [categoryId], references: [id])
  author        Author     @relation(fields: [authorId], references: [id])
  publisher     Publisher? @relation(fields: [publisherId], references: [id])
  
  items         BookItem[]
  reservations  Reservation[]
}

model BookItem {
  id          Int      @id @default(autoincrement())
  bookId      Int
  barcode     String   @unique // Mã vạch dán trên cuốn vật lý để tít máy quét
  location    String?  // Vị trí: "Khu A - Kệ 3"
  status      String   @default("AVAILABLE") // AVAILABLE, BORROWED, LOST, DAMAGED
  
  book        Book     @relation(fields: [bookId], references: [id])
  loans       Loan[]
}

// --- 3. MẢNG MƯỢN TRẢ & LƯU THÔNG ---
model Loan {
  id         Int      @id @default(autoincrement())
  userId     Int
  bookItemId Int      // Liên kết tới cuốn sách vật lý (BookItem) thay vì Book chung
  borrowDate DateTime @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status               String    @default("BORROWING") // BORROWING, RETURNED, OVERDUE, LOST
  fineAmount           Float     @default(0) // Tiền phạt
  compensationAmount   Float?    @default(0) // Số tiền đền bù khi làm mất/hỏng sách
  isFinePaid           Boolean   @default(false) // Trạng thái đã nộp phạt
  finePaidAt           DateTime? // Thời điểm thanh toán phạt
  paymentMethod        String?   // "MOMO", "VNPAY", "BANK_TRANSFER"
  paymentTransactionId String?   // Mã giao dịch thanh toán

  user       User     @relation(fields: [userId], references: [id])
  bookItem   BookItem @relation(fields: [bookItemId], references: [id])
}

model Reservation {
  id         Int      @id @default(autoincrement())
  userId     Int
  bookId     Int
  status     String   @default("WAITING") // WAITING, NOTIFIED, FULFILLED, CANCELLED
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  book       Book     @relation(fields: [bookId], references: [id])
}