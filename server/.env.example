# Mẫu cấu hình server. Sao chép thành server/.env rồi điền giá trị thật (không commit .env).
# Để trống SMTP_USER/SMTP_PASS thì mailService dùng tài khoản Ethereal giả lập.
PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET=""

# Cấu hình gửi Email qua Gmail SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
